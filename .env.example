# Optional: Provide a full Firebase service account JSON via environment instead of individual FIREBASE_* vars
# Set FIREBASE_SERVICE_ACCOUNT to a JSON string containing the service account credentials (escape newlines in the private_key or wrap in single quotes)
# Example (use with care):
# export FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}'
# If FIREBASE_SERVICE_ACCOUNT is set, the migration script will use it; otherwise it will fall back to default app credentials.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}'

# SendGrid API key for sending emails. Keep secret and do NOT commit to git.
# Example: SENDGRID_API_KEY=SG.xxxxx
SENDGRID_API_KEY=

# Whether US-only email automation is enabled. Defaults to false for safety.
# Set ENABLE_EMAIL_US=true to allow the automation to actually send emails (use with care).
ENABLE_EMAIL_US=false

# Default from address for emails sent via SendGrid
EMAIL_FROM=Example <no-reply@example.com>

# Optional Redis URL for queuing/background workers (e.g., redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Optional SendGrid rate limit configuration (messages per second)
# Use a number like 10 to limit sending throughput and avoid throttling.
SENDGRID_RATE_LIMIT=10

# NOTES: The email automation will by default run in a dry-run mode for local testing.
# - Keep ENABLE_EMAIL_US=false to prevent real sends and allow unit/integration tests to run safely.
# - To perform a real send locally set ENABLE_EMAIL_US=true and ensure SENDGRID_API_KEY is set.
# - When providing FIREBASE_SERVICE_ACCOUNT via FIREBASE_SERVICE_ACCOUNT env var, escape newlines in private_key or wrap value in single quotes.

# Scraper Database Setup
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leads_db
DB_USER=postgres
DB_PASSWORD=password

# Proxy (optional — residential proxy strongly recommended for production)
PROXY_URL=

# Scraper behaviour
LOG_LEVEL=info
MAX_RESULTS_PER_TARGET=60
BROWSER_HEADLESS=true
REQUEST_TIMEOUT_MS=8000

# Scraper Rate limiting (increase delays if getting blocked)
MIN_DELAY_MS=1200
MAX_DELAY_MS=3000
AIRBNB_MIN_DELAY_MS=4000
FACEBOOK_MIN_DELAY_MS=3000
